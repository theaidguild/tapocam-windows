<Window x:Class="TapoCam.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TapoCam" Height="640" Width="960" MinHeight="520" MinWidth="900"
        Background="#111318" Foreground="#F3F4F6">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="TapoCam" FontSize="24" FontWeight="SemiBold" />
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Nenhuma câmera" FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center" />
            <TextBlock Text="Adicione uma câmera com IP, usuário e senha em Ajustes."
                       Margin="0,10,0,0" Foreground="#A1A1AA" />
        </StackPanel>
    </Grid>
</Window>
